{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/error.schema.json",
  "title": "GatewayErrorResponse",
  "description": "Standard error response body returned by Operator Gateway A upon request refusal",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Authoritative machine-readable error code"
    },
    "message": {
      "type": "string",
      "description": "Human-readable summary of failure reason"
    },
    "request_id": {
      "type": "string",
      "description": "Unique UUID request trace identifier"
    },
    "error": {
      "type": "string",
      "description": "Deprecated backwards-compatible mirror of code"
    }
  },
  "required": ["code", "message", "request_id"],
  "additionalProperties": false
}
