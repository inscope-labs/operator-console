{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/plan-status.schema.json",
  "title": "PlanStatusResponse",
  "description": "Status and milestone details of a specific plan from GET /plans/{id}/status",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "in_progress", "completed", "halted", "archived"]
    },
    "halted": { "type": "boolean" },
    "openBranches": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockedTasks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "currentMilestone": { "type": "string" }
  },
  "required": ["id", "status", "halted", "openBranches", "blockedTasks", "currentMilestone"],
  "additionalProperties": false
}
