{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/upload.schema.json",
  "title": "UploadTaskSubmission",
  "description": "Request and response schemas for POST /tasks/{id}/upload",
  "definitions": {
    "request": {
      "type": "object",
      "properties": {
        "plan": { "type": "string" },
        "task": { "type": "string" },
        "branch": { "type": "string" },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "submissionId": { "type": "string" },
        "zipSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "zipBase64": { "type": "string" },
        "capability": { "type": "string" }
      },
      "required": ["plan", "task", "branch", "head", "submissionId", "zipSha256", "zipBase64", "capability"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "accepted": { "type": "boolean" },
        "operation": {
          "type": "string",
          "enum": ["UPLOAD", "upload"]
        },
        "branch": { "type": "string" },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "auditRef": { "type": "string" }
      },
      "required": ["accepted", "operation", "branch", "headSha", "auditRef"],
      "additionalProperties": false
    }
  }
}
