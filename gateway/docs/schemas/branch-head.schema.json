{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/branch-head.schema.json",
  "title": "BranchHeadResponse",
  "description": "Branch HEAD commit SHA from GET /branches/{name}/head",
  "type": "object",
  "properties": {
    "branch": { "type": "string" },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "required": ["branch", "headSha"],
  "additionalProperties": false
}
