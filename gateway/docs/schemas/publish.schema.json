{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/publish.schema.json",
  "title": "PublishTaskOperation",
  "description": "Request and response schemas for POST /tasks/{id}/publish",
  "definitions": {
    "request": {
      "type": "object",
      "properties": {
        "plan": { "type": "string" },
        "task": { "type": "string" },
        "branch": {
          "type": "string",
          "pattern": "^task-[A-Za-z0-9._-]+$"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "capability": {
          "type": "string",
          "description": "Signed ctxop-v1 capability string"
        }
      },
      "required": ["plan", "task", "branch", "head", "capability"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "accepted": { "type": "boolean" },
        "operation": {
          "type": "string",
          "enum": ["PUBLISH", "publish"]
        },
        "branch": { "type": "string" },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "auditRef": { "type": "string" }
      },
      "required": ["accepted", "operation", "branch", "headSha", "auditRef"],
      "additionalProperties": false
    }
  }
}
