<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing this app stores may be backed up. The operator credential and the device
    enrolment record are bound to this device and must not leave it.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
