{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/health.schema.json",
  "title": "GatewayHealthResponse",
  "description": "Liveness and environment probe response from GET /health",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "degraded"]
    },
    "environment": {
      "type": "string",
      "enum": ["test", "staging", "production"]
    },
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix epoch timestamp in seconds"
    },
    "config": {
      "type": "object",
      "properties": {
        "valid": { "type": "boolean" },
        "missing": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["valid"]
    }
  },
  "required": ["status", "environment", "version", "timestamp"],
  "additionalProperties": false
}
