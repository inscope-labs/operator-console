{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/decide.schema.json",
  "title": "DecideOperation",
  "description": "Request and response schemas for POST /plans/{id}/decide",
  "definitions": {
    "request": {
      "type": "object",
      "properties": {
        "plan": { "type": "string" },
        "task": { "type": "string" },
        "branch": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["APPROVED", "REJECTED", "DEFERRED"]
        },
        "notes": { "type": "string" },
        "capability": { "type": "string" }
      },
      "required": ["plan", "decision", "capability"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "accepted": { "type": "boolean" },
        "operation": {
          "type": "string",
          "enum": ["DECIDE", "decide"]
        },
        "plan": { "type": "string" },
        "decision": { "type": "string" },
        "auditRef": { "type": "string" }
      },
      "required": ["accepted", "operation", "plan", "decision", "auditRef"],
      "additionalProperties": false
    }
  }
}
