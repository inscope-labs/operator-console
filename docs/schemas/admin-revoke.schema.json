{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/admin-revoke.schema.json",
  "title": "AdminRevokeDeviceKey",
  "description": "Request and response schemas for POST /admin/revoke",
  "definitions": {
    "request": {
      "type": "object",
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,16}$"
        },
        "reason": { "type": "string" },
        "confirmation": { "type": "string" }
      },
      "required": ["kid", "reason", "confirmation"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "revoked": { "type": "boolean" },
        "kid": { "type": "string" },
        "revokedAt": { "type": "integer" }
      },
      "required": ["revoked", "kid", "revokedAt"],
      "additionalProperties": false
    }
  }
}
