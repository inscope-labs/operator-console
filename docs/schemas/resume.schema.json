{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/resume.schema.json",
  "title": "ResumeEngineOperation",
  "description": "Request and response schemas for POST /resume",
  "definitions": {
    "request": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "enum": ["engine"]
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reason": { "type": "string" },
        "idempotencyKey": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "Client-generated operation idempotency key (contract section 1.6); not the capability nonce" },
        "capability": { "type": "string" }
      },
      "required": ["branch", "head", "reason", "idempotencyKey", "capability"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "accepted": { "type": "boolean" },
        "operation": {
          "type": "string",
          "enum": ["RESUME", "resume"]
        },
        "branch": { "type": "string" },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "auditRef": { "type": "string" }
      },
      "required": ["accepted", "operation", "branch", "headSha", "auditRef"],
      "additionalProperties": false
    }
  }
}
