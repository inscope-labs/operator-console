{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inscope-labs.com/schemas/operator-gateway/plans-list.schema.json",
  "title": "PlansListResponse",
  "description": "List of active and archived plans from GET /plans",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["draft", "ready", "in_progress", "completed", "halted", "archived"]
      },
      "taskCount": { "type": "integer", "minimum": 0 },
      "completedTaskCount": { "type": "integer", "minimum": 0 },
      "updatedAt": { "type": "integer" }
    },
    "required": ["id", "title", "status", "taskCount", "completedTaskCount", "updatedAt"],
    "additionalProperties": false
  }
}
